#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/solocode-validate-xcode.sh"
source "$SCRIPT_DIR/lib/solocode-validate-files.sh"

TRIGGER=""
WORKSPACE=""
FILES_CSV=""
PATCH_FILE=""
FORMAT="text"
STAGED="false"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --trigger) TRIGGER="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --files) FILES_CSV="$2"; shift 2 ;;
    --patch-file) PATCH_FILE="$2"; shift 2 ;;
    --format) FORMAT="$2"; shift 2 ;;
    --staged) STAGED="true"; shift ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$TRIGGER" || -z "$WORKSPACE" ]]; then
  echo "Usage: solocode-validate --trigger <reviewPatchPreview|reviewPatchApply|gitCommit|ciFull> --workspace <path> [--files csv] [--patch-file path] [--staged] [--format text|json]" >&2
  exit 1
fi
cd "$WORKSPACE"

if [[ "$STAGED" == "true" ]]; then
  FILES_CSV="$(git diff --cached --name-only --diff-filter=ACMR | paste -sd, -)"
fi

FILES=()
if [[ -n "${FILES_CSV:-}" ]]; then
  while IFS= read -r file; do
    trimmed="$(echo "$file" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -n "$trimmed" ]] && FILES+=("$trimmed")
  done < <(printf '%s\n' "$FILES_CSV" | tr ',' '\n')
fi

log() { [[ "$FORMAT" == "text" ]] && echo "$1"; }
array_count() { [[ "$#" -eq 1 && -z "${1:-}" ]] && echo 0 || echo "$#"; }
json_escape() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }
fail() {
  local stage="$1" message="$2"
  [[ "$FORMAT" == "json" ]] \
    && printf '{"status":"failed","stage":"%s","message":%s}\n' "$stage" "$(json_escape "$message")" \
    || echo "[FAILED] $stage: $message" >&2
  exit 1
}
pass() { log "[PASSED] $1"; }

prepare_validation_xcode_paths "$WORKSPACE"

build_for_testing() {
  if should_resolve_packages "$WORKSPACE"; then
    xcodebuild -resolvePackageDependencies -workspace "Solo Code.xcworkspace" -scheme "Solo Code-Debug" -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" >/tmp/solocode-validate-resolve-packages.log 2>&1 \
      || fail "packageResolve" "$(tail -n 60 /tmp/solocode-validate-resolve-packages.log)"
    mark_package_resolution_ready
    pass "packageResolve"
  else
    log "[SKIPPED] packageResolve"
  fi
  xcodebuild build-for-testing \
    -workspace "Solo Code.xcworkspace" \
    -scheme "Solo Code-Debug" \
    -destination "platform=macOS" \
    -derivedDataPath "$DERIVED_DATA_PATH" -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" >/tmp/solocode-validate-build-for-testing.log 2>&1 \
    || fail "buildForTesting" "$(tail -n 60 /tmp/solocode-validate-build-for-testing.log)"
  ./scripts/bootstrap_test_bundles.sh "$DERIVED_DATA_PATH/Build/Products/Debug" \
    || fail "testBootstrap" "bootstrap_test_bundles.sh fallito"
  pass "buildForTesting"
}

run_tests_without_building() {
  local stage="$1"
  local log_file="$2"
  shift 2
  xcodebuild test-without-building \
    -workspace "Solo Code.xcworkspace" \
    -scheme "Solo Code-Debug" \
    -destination "platform=macOS" \
    -parallel-testing-enabled "$PARALLEL_TESTING_ENABLED" \
    -derivedDataPath "$DERIVED_DATA_PATH" -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" \
    "$@" >"$log_file" 2>&1 \
    || fail "$stage" "$(tail -n 60 "$log_file")"
}

files_count="$(array_count "${FILES[@]-}")"
if [[ "$files_count" -eq 0 && "$TRIGGER" != "ciFull" ]]; then
  fail "scope" "Nessun file da validare."
fi

if [[ -n "$PATCH_FILE" && "$TRIGGER" != "reviewPatchPreview" ]]; then
  git apply --check "$PATCH_FILE" || fail "patchSafety" "git apply --check fallito per $PATCH_FILE"
  pass "patchSafety"
fi

if ! validate_code_size_limit "${FILES[@]-}"; then
  fail "codeSize" "Uno o piu file toccati superano il limite 300 righe."
fi
pass "codeSize"

./scripts/validate_rust_cutover_boundary.sh --trigger "$TRIGGER" --workspace "$WORKSPACE" --files "$FILES_CSV" --format "$FORMAT" $([[ "$STAGED" == "true" ]] && printf '%s' --staged)
pass "rustCutoverBoundary"

TEST_ARGS=()
need_engine_fallback="false"
need_app_fallback="false"
need_integration="false"
native_only_validation="true"

for file in "${FILES[@]-}"; do
  [[ -z "$file" ]] && continue
  case "$file" in
    Native/*|Config/validation/*|scripts/solocode-validate|scripts/validate_rust_cutover_boundary.sh|.github/workflows/ci.yml|.gitignore|docs/*)
      ;;
    *)
      native_only_validation="false"
      ;;
  esac

  case "$file" in
    Native/RustCore/src/main_chat/providers/cli/codex_app_server.rs|Native/RustCore/src/main_chat/providers/cli/codex_app_server_mcp_status.rs|Native/RustCore/src/main_chat/providers/cli/codex_app_server_support.rs|Native/RustCore/src/main_chat/providers/cli/codex_app_server_tool_search.rs|Native/RustCore/src/main_chat/providers/cli/codex_app_server_prompt.rs)
      TEST_ARGS+=(
        "-only-testing:CoderEngineTests/CodexAppServerMCPWireIntegrationTests"
        "-only-testing:CoderEngineTests/CodexCLIProviderRealisticSequenceTests"
        "-only-testing:CoderEngineTests/CodexCLINativeToolInterleavingRegressionTests"
        "-only-testing:CoderEngineTests/ToolEnabledLLMProviderMCPWarmupTests"
      )
      ;;
    Engine/CoderEngine/Sources/Infrastructure/MCP/Config/Parsing/MCPConfigLoader+CodexParsing.swift|Engine/CoderEngine/Sources/ProviderBackends/CodexCLI/*)
      TEST_ARGS+=(
        "-only-testing:CoderEngineTests/MCPConfigLoaderParsingTests"
        "-only-testing:CoderEngineTests/CodexCLIProviderInvocationTests"
        "-only-testing:CoderEngineTests/CodexAppServerMCPWireIntegrationTests"
      )
      ;;
    Engine/CoderEngine/Sources/Validation/*)
      TEST_ARGS+=(
        "-only-testing:CoderEngineTests/ValidationProfileResolverTests"
        "-only-testing:CoderEngineTests/TargetedTestsSelectorTests"
        "-only-testing:CoderEngineTests/PatchSafetyStageTests"
        "-only-testing:CoderEngineTests/CodeSizeStageTests"
        "-only-testing:CoderEngineTests/ValidationOrchestratorTests"
        "-only-testing:CoderEngineTests/ValidationPerformanceTests"
      )
      ;;
    Engine/CoderEngine/Sources/PersistenceCore/*|Tests/CoderEngineTests/Persistence/*|Tests/CoderEngineTests/VerifiedFindings/HistoricalFindingsQueryServiceTests.swift)
      TEST_ARGS+=("-only-testing:CoderEngineTests/HistoricalFindingsQueryServiceTests")
      ;;
    Engine/CoderEngine/Sources/Pipeline/*)
      TEST_ARGS+=("-only-testing:CoderEngineTests/Pipeline")
      ;;
    Engine/CoderEngine/Sources/CodeReview/*)
      TEST_ARGS+=("-only-testing:CoderEngineTests/CodeReview")
      ;;
    Engine/CoderEngine/Sources/CodebaseIndex/Indexing/RustSearchFFIClient.swift)
      ;;
    Engine/CoderEngine/Sources/Tools/*|Tools/CoderIDEMCPServer/Sources/*)
      TEST_ARGS+=("-only-testing:CoderEngineTests/UnifiedToolRuntime")
      ;;
    Engine/*|Tools/*)
      need_engine_fallback="true"
      ;;
  esac

  case "$file" in
    App/SoloCodeApp/Sources/Git/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/GitServiceTests" "-only-testing:SoloCodeAppTests/GitServiceValidationGuardTests")
      ;;
    App/SoloCodeApp/Sources/Accounts/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/CLIMultiAccountProviderAdapterTests" "-only-testing:SoloCodeAppTests/CLIAccountAuthDetectorTests" "-only-testing:SoloCodeAppTests/CLIAccountLoginCoordinatorTests" "-only-testing:SoloCodeAppTests/CLIProfileProvisionerTests" "-only-testing:SoloCodeAppTests/CLIProfileProvisionerInstructionSyncTests" "-only-testing:SoloCodeAppTests/ProviderFactoryRuntimeParityTests")
      ;;
    App/SoloCodeApp/Sources/Panels/CodeReview/Coordinator/*|App/SoloCodeApp/Sources/Panels/CodeReview/Store/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/CodeReviewPanelLiveRunExecutionTests" "-only-testing:SoloCodeAppTests/CodeReviewPanelChatStateDeferralTests" "-only-testing:SoloCodeAppTests/ReviewPanelLifecycleE2ETests")
      ;;
    App/SoloCodeApp/Sources/CodeReview/*|App/SoloCodeApp/Sources/Panels/CodeReview/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ReviewPatchWorkflowServiceTests")
      ;;
    App/SoloCodeApp/Sources/Chat/Support/Providers/*|Tests/SoloCodeAppTests/ThreadProviderSelectionServiceTests.swift)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ThreadProviderSelectionServiceTests" "-only-testing:SoloCodeAppTests/ProviderFactoryRuntimeParityTests")
      ;;
    App/SoloCodeApp/Sources/Chat/Support/StoreRust/*|App/SoloCodeApp/Sources/Chat/Support/StoreRuntime/*|Tests/SoloCodeAppTests/ChatStoreTaskOwnershipTests.swift|Tests/SoloCodeAppTests/ChatStoreStreamingTargetTests.swift)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ChatStoreTaskOwnershipTests" "-only-testing:SoloCodeAppTests/ChatStoreStreamingTargetTests" "-only-testing:SoloCodeAppTests/ChatStoreMarkerSanitizationTests" "-only-testing:SoloCodeAppTests/PipelineIntegrationServiceTests")
      ;;
    App/SoloCodeApp/Sources/Chat/Support/StoreProjection/Messages/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ChatStoreStreamingTargetTests" "-only-testing:SoloCodeAppTests/ChatStoreMarkerSanitizationTests" "-only-testing:SoloCodeAppTests/PipelineIntegrationServiceTests")
      ;;
    App/SoloCodeApp/Sources/Chat/Support/Extensions/ChatPanelView+PartS_End.swift|App/SoloCodeApp/Sources/Chat/Support/ChatPanelSupport+TaskStatus.swift)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ChatStoreMarkerSanitizationTests")
      ;;
    App/SoloCodeApp/Sources/Chat/Support/StoreProjection/Conversations/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ChatStoreTaskOwnershipTests")
      ;;
    App/SoloCodeApp/Sources/Chat/ChatPanelView.swift|App/SoloCodeApp/Sources/Chat/ChatBackgroundStyle.swift|App/SoloCodeApp/Sources/Chat/Support/ChatPanelThreadUIState.swift)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ChatBackgroundStyleTests")
      ;;
    App/SoloCodeApp/Sources/Chat/Support/Plan/PlanScreeningDecision.swift|App/SoloCodeApp/Sources/Chat/Support/ChatPanelSupport+PlanFlowHelpers.swift)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/PlanShortcutAndCommandTests")
      ;;
    App/SoloCodeApp/Sources/Runtime/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/PipelineIntegrationServiceTests")
      ;;
    App/*)
      need_app_fallback="true"
      ;;
  esac
  case "$file" in
    *CodeReview*|*Git/*|*Runtime/*|*Validation/*|*Patching/*)
      [[ "$TRIGGER" == "ciFull" ]] && need_integration="true"
      ;;
  esac
done

if [[ "$TRIGGER" == "ciFull" ]]; then need_engine_fallback="true"; need_app_fallback="true"; need_integration="true"; fi

[[ "$need_engine_fallback" == "true" ]] && TEST_ARGS+=("-only-testing:CoderEngineTests"); [[ "$need_app_fallback" == "true" ]] && TEST_ARGS+=("-only-testing:SoloCodeAppTests"); [[ "$need_integration" == "true" ]] && TEST_ARGS+=("-only-testing:SoloCodeIntegrationTests")
test_args_seed_count="$(array_count "${TEST_ARGS[@]-}")"
[[ "$test_args_seed_count" -eq 0 && "$native_only_validation" != "true" ]] && TEST_ARGS+=("-only-testing:CoderEngineTests")

deduped_args=()
while IFS= read -r arg; do
  [[ -n "$arg" ]] && deduped_args+=("$arg")
done < <(dedupe_cli_args "${TEST_ARGS[@]-}")
test_args_count="$(array_count "${deduped_args[@]-}")"
if [[ "$test_args_count" -gt 0 ]]; then
  TEST_ARGS=("${deduped_args[@]}")
else
  TEST_ARGS=()
fi

if [[ "$test_args_count" -gt 0 ]]; then
  if [[ "$TRIGGER" == "ciFull" ]]; then
    xcodebuild build \
      -workspace "Solo Code.xcworkspace" \
      -scheme "Solo Code-Release" \
      -destination "platform=macOS" \
      -derivedDataPath "$DERIVED_DATA_PATH" \
      -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" >/tmp/solocode-validate-build.log 2>&1 \
      || fail "build" "$(tail -n 40 /tmp/solocode-validate-build.log)"
    pass "build"
  fi
  build_for_testing
  run_tests_without_building targetedTests /tmp/solocode-validate-tests.log "${TEST_ARGS[@]}"
  pass "targetedTests"
else
  if [[ "$native_only_validation" == "true" && "$TRIGGER" != "ciFull" ]]; then
    log "[SKIPPED] build"
  else
    xcodebuild build \
      -workspace "Solo Code.xcworkspace" \
      -scheme "$([[ "$TRIGGER" == "ciFull" ]] && echo "Solo Code-Release" || echo "Solo Code-Debug")" \
      -destination "platform=macOS" \
      -derivedDataPath "$DERIVED_DATA_PATH" \
      -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" >/tmp/solocode-validate-build.log 2>&1 \
      || fail "build" "$(tail -n 40 /tmp/solocode-validate-build.log)"
    pass "build"
  fi
  log "[SKIPPED] targetedTests"
fi

needs_security="false"
for file in "${FILES[@]-}"; do
  [[ -z "$file" ]] && continue
  case "$file" in
    App/SoloCodeApp/Sources/Accounts/*|App/SoloCodeApp/Sources/Git/*|App/SoloCodeApp/Sources/CodeReview/*|App/SoloCodeApp/Sources/Runtime/*|Engine/CoderEngine/Sources/CodeReview/*|Engine/CoderEngine/Sources/Pipeline/Patching/*|Engine/CoderEngine/Sources/Tools/Runtime/*|Engine/CoderEngine/Sources/Infrastructure/MCP/*|Engine/CoderEngine/Sources/Infrastructure/Process/*|Tools/CoderIDEMCPServer/Sources/*)
      needs_security="true"
      ;;
  esac
done

if [[ "$needs_security" == "true" || "$TRIGGER" == "ciFull" ]]; then
  private_key_marker='-----BEGIN PRIVATE'; secret_scan_pattern="(AKIA[0-9A-Z]{16}|${private_key_marker} KEY-----|password\s*=\s*[^[:space:])]+|token\s*=\s*[^[:space:])]+)"
  if [[ "$files_count" -gt 0 ]]; then
    security_scan_paths=("${FILES[@]}")
  else
    security_scan_paths=(".")
  fi
  if rg -n --hidden --glob '!App/SoloCodeApp/Resources/**' "$secret_scan_pattern" "${security_scan_paths[@]}" >/tmp/solocode-validate-security.log 2>&1; then
    fail "security" "$(cat /tmp/solocode-validate-security.log)"
  fi
  pass "security"
else
  log "[SKIPPED] security"
fi

if [[ "$TRIGGER" == "gitCommit" || "$TRIGGER" == "ciFull" ]]; then
  if rg -n 'patch workflow|commit guard|validation' docs/bugs >/tmp/solocode-validate-regression.log 2>/dev/null; then
    pass "regression"
  else
    log "[SKIPPED] regression"
  fi
fi

if [[ "$TRIGGER" == "ciFull" ]]; then
  run_tests_without_building performance /tmp/solocode-validate-performance.log \
    -only-testing:CoderEngineTests/ValidationPerformanceTests
  pass "performance"
  if find Tests/SoloCodeIntegrationTests -name '*.swift' -print -quit | grep -q .; then
    run_tests_without_building e2e /tmp/solocode-validate-e2e.log -only-testing:SoloCodeIntegrationTests
    pass "e2e"
  else
    log "[SKIPPED] e2e"
  fi
fi

if [[ "$FORMAT" == "json" ]]; then
  printf '{"status":"passed","trigger":"%s","files":%s}\n' "$TRIGGER" "$(printf '%s\n' "${FILES[@]-}" | python3 -c 'import json,sys; print(json.dumps([line.strip() for line in sys.stdin if line.strip()]))')"
else
  echo "Validation passed for $TRIGGER"
fi
