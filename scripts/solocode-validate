#!/usr/bin/env bash
set -euo pipefail

TRIGGER=""
WORKSPACE=""
FILES_CSV=""
PATCH_FILE=""
FORMAT="text"
STAGED="false"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --trigger) TRIGGER="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --files) FILES_CSV="$2"; shift 2 ;;
    --patch-file) PATCH_FILE="$2"; shift 2 ;;
    --format) FORMAT="$2"; shift 2 ;;
    --staged) STAGED="true"; shift ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$TRIGGER" || -z "$WORKSPACE" ]]; then
  echo "Usage: solocode-validate --trigger <reviewPatchPreview|reviewPatchApply|gitCommit|ciFull> --workspace <path> [--files csv] [--patch-file path] [--staged] [--format text|json]" >&2
  exit 1
fi
cd "$WORKSPACE"

if [[ "$STAGED" == "true" ]]; then
  FILES_CSV="$(git diff --cached --name-only --diff-filter=ACMR | paste -sd, -)"
fi

FILES=()
if [[ -n "${FILES_CSV:-}" ]]; then
  while IFS= read -r file; do
    trimmed="$(echo "$file" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -n "$trimmed" ]] && FILES+=("$trimmed")
  done < <(printf '%s' "$FILES_CSV" | tr ',' '\n')
fi

log() {
  if [[ "$FORMAT" == "text" ]]; then
    echo "$1"
  fi
}

json_escape() {
  printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
}

fail() {
  local stage="$1"
  local message="$2"
  if [[ "$FORMAT" == "json" ]]; then
    printf '{"status":"failed","stage":"%s","message":%s}\n' "$stage" "$(json_escape "$message")"
  else
    echo "[FAILED] $stage: $message" >&2
  fi
  exit 1
}

pass() {
  log "[PASSED] $1"
}
DERIVED_DATA_PATH="${TMPDIR%/}/solocode-validate-derived-data"; SOURCE_PACKAGES_DIR="${TMPDIR%/}/solocode-validate-source-packages-$$"

build_for_testing() {
  chmod -R u+w "$DERIVED_DATA_PATH" "$SOURCE_PACKAGES_DIR" 2>/dev/null || true; python3 -c 'import shutil,sys; [shutil.rmtree(path, ignore_errors=True) for path in sys.argv[1:]]' "$DERIVED_DATA_PATH" "$SOURCE_PACKAGES_DIR"
  xcodebuild -resolvePackageDependencies -workspace "Solo Code.xcworkspace" -scheme "Solo Code-Debug" -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" >/tmp/solocode-validate-resolve-packages.log 2>&1 \
    || fail "packageResolve" "$(tail -n 60 /tmp/solocode-validate-resolve-packages.log)"
  xcodebuild build-for-testing \
    -workspace "Solo Code.xcworkspace" \
    -scheme "Solo Code-Debug" \
    -destination "platform=macOS" \
    -derivedDataPath "$DERIVED_DATA_PATH" -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" >/tmp/solocode-validate-build-for-testing.log 2>&1 \
    || fail "buildForTesting" "$(tail -n 60 /tmp/solocode-validate-build-for-testing.log)"
  ./scripts/bootstrap_test_bundles.sh "$DERIVED_DATA_PATH/Build/Products/Debug" \
    || fail "testBootstrap" "bootstrap_test_bundles.sh fallito"
  pass "buildForTesting"
}

run_tests_without_building() {
  local stage="$1"
  local log_file="$2"
  shift 2
  xcodebuild test-without-building \
    -workspace "Solo Code.xcworkspace" \
    -scheme "Solo Code-Debug" \
    -destination "platform=macOS" -parallel-testing-enabled NO \
    -derivedDataPath "$DERIVED_DATA_PATH" -clonedSourcePackagesDirPath "$SOURCE_PACKAGES_DIR" \
    "$@" >"$log_file" 2>&1 \
    || fail "$stage" "$(tail -n 60 "$log_file")"
}

if [[ ${#FILES[@]} -eq 0 && "$TRIGGER" != "ciFull" ]]; then
  fail "scope" "Nessun file da validare."
fi

if [[ -n "$PATCH_FILE" && "$TRIGGER" != "reviewPatchPreview" ]]; then
  git apply --check "$PATCH_FILE" || fail "patchSafety" "git apply --check fallito per $PATCH_FILE"
  pass "patchSafety"
fi
is_code_file() {
  local path="$1"
  [[ "$path" == App/SoloCodeApp/Resources/* ]] && return 1
  [[ "$path" == *".xcassets/"* ]] && return 1
  [[ "$path" == App/SoloCodeApp/Resources/monaco/* ]] && return 1
  [[ "$path" == *.swift || "$path" == *.sh || "$path" == *.rb || "$path" == *.rs ]] || return 1
  return 0
}

line_count() {
  python3 - "$1" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
print(len(text.splitlines()) if text else 0)
PY
}

for file in "${FILES[@]}"; do
  is_code_file "$file" || continue
  [[ -f "$file" ]] || continue
  lines="$(line_count "$file")"
  if [[ "$lines" -gt 300 ]]; then
    old_lines=""
    if git cat-file -e "HEAD:$file" >/dev/null 2>&1; then
      old_lines="$(git show "HEAD:$file" | python3 -c 'import sys; print(len(sys.stdin.read().splitlines()))')"
    fi
    if [[ -z "$old_lines" || "$old_lines" -le 300 || "$lines" -gt "$old_lines" ]]; then
      fail "codeSize" "$file supera il limite 300 righe ($old_lines->$lines)."
    fi
  fi
done
pass "codeSize"

./scripts/validate_rust_cutover_boundary.sh --trigger "$TRIGGER" --workspace "$WORKSPACE" --files "$FILES_CSV" --format "$FORMAT" $([[ "$STAGED" == "true" ]] && printf '%s' --staged)
pass "rustCutoverBoundary"

xcodebuild build \
  -workspace "Solo Code.xcworkspace" \
  -scheme "$([[ "$TRIGGER" == "ciFull" ]] && echo "Solo Code-Release" || echo "Solo Code-Debug")" \
  -destination "platform=macOS" >/tmp/solocode-validate-build.log 2>&1 \
  || fail "build" "$(tail -n 40 /tmp/solocode-validate-build.log)"
pass "build"

TEST_ARGS=()
need_engine_fallback="false"
need_app_fallback="false"
need_integration="false"
native_only_validation="true"

for file in "${FILES[@]}"; do
  case "$file" in
    Native/*|Config/validation/*|scripts/solocode-validate|scripts/validate_rust_cutover_boundary.sh|.github/workflows/validation.yml|.gitignore|docs/*)
      ;;
    *)
      native_only_validation="false"
      ;;
  esac

  case "$file" in
    Engine/CoderEngine/Sources/Validation/*)
      TEST_ARGS+=(
        "-only-testing:CoderEngineTests/ValidationProfileResolverTests"
        "-only-testing:CoderEngineTests/TargetedTestsSelectorTests"
        "-only-testing:CoderEngineTests/PatchSafetyStageTests"
        "-only-testing:CoderEngineTests/CodeSizeStageTests"
        "-only-testing:CoderEngineTests/ValidationOrchestratorTests"
        "-only-testing:CoderEngineTests/ValidationPerformanceTests"
      )
      ;;
    Engine/CoderEngine/Sources/PersistenceCore/*|Tests/CoderEngineTests/Persistence/*|Tests/CoderEngineTests/VerifiedFindings/HistoricalFindingsQueryServiceTests.swift)
      TEST_ARGS+=("-only-testing:CoderEngineTests/HistoricalFindingsQueryServiceTests")
      ;;
    Engine/CoderEngine/Sources/Pipeline/*)
      TEST_ARGS+=("-only-testing:CoderEngineTests/Pipeline")
      ;;
    Engine/CoderEngine/Sources/CodeReview/*)
      TEST_ARGS+=("-only-testing:CoderEngineTests/CodeReview")
      ;;
    Engine/CoderEngine/Sources/CodebaseIndex/Indexing/RustSearchFFIClient.swift)
      ;;
    Engine/CoderEngine/Sources/Tools/*|Tools/CoderIDEMCPServer/Sources/*)
      TEST_ARGS+=("-only-testing:CoderEngineTests/UnifiedToolRuntime")
      ;;
    Engine/*|Tools/*)
      need_engine_fallback="true"
      ;;
  esac

  case "$file" in
    App/SoloCodeApp/Sources/Git/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/GitServiceTests" "-only-testing:SoloCodeAppTests/GitServiceValidationGuardTests")
      ;;
    App/SoloCodeApp/Sources/Panels/CodeReview/Coordinator/*|App/SoloCodeApp/Sources/Panels/CodeReview/Store/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/CodeReviewPanelLiveRunExecutionTests" "-only-testing:SoloCodeAppTests/CodeReviewPanelChatStateDeferralTests" "-only-testing:SoloCodeAppTests/ReviewPanelLifecycleE2ETests")
      ;;
    App/SoloCodeApp/Sources/CodeReview/*|App/SoloCodeApp/Sources/Panels/CodeReview/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/ReviewPatchWorkflowServiceTests")
      ;;
    App/SoloCodeApp/Sources/Runtime/*)
      TEST_ARGS+=("-only-testing:SoloCodeAppTests/PipelineIntegrationServiceTests")
      ;;
    App/*)
      need_app_fallback="true"
      ;;
  esac
  case "$file" in
    *CodeReview*|*Git/*|*Runtime/*|*Validation/*|*Patching/*)
      [[ "$TRIGGER" == "ciFull" ]] && need_integration="true"
      ;;
  esac
done

if [[ "$TRIGGER" == "ciFull" ]]; then
  need_engine_fallback="true"
  need_app_fallback="true"
  need_integration="true"
fi

[[ "$need_engine_fallback" == "true" ]] && TEST_ARGS+=("-only-testing:CoderEngineTests")
[[ "$need_app_fallback" == "true" ]] && TEST_ARGS+=("-only-testing:SoloCodeAppTests")
[[ "$need_integration" == "true" ]] && TEST_ARGS+=("-only-testing:SoloCodeIntegrationTests")
[[ ${#TEST_ARGS[@]} -eq 0 && "$native_only_validation" != "true" ]] && TEST_ARGS+=("-only-testing:CoderEngineTests")

deduped_args=()
for arg in "${TEST_ARGS[@]-}"; do
  [[ -z "$arg" ]] && continue
  skip="false"
  for existing in "${deduped_args[@]-}"; do
    [[ "$existing" == "$arg" ]] && skip="true"
  done
  [[ "$skip" == "false" ]] && deduped_args+=("$arg")
done
test_args_count="${#deduped_args[@]}"
if [[ "$test_args_count" -gt 0 ]]; then
  TEST_ARGS=("${deduped_args[@]}")
else
  TEST_ARGS=()
fi

if [[ "$test_args_count" -gt 0 ]]; then
  build_for_testing
  run_tests_without_building targetedTests /tmp/solocode-validate-tests.log "${TEST_ARGS[@]}"
  pass "targetedTests"
else
  log "[SKIPPED] targetedTests"
fi

needs_security="false"
for file in "${FILES[@]}"; do
  case "$file" in
    App/SoloCodeApp/Sources/Git/*|App/SoloCodeApp/Sources/CodeReview/*|App/SoloCodeApp/Sources/Runtime/*|Engine/CoderEngine/Sources/CodeReview/*|Engine/CoderEngine/Sources/Pipeline/Patching/*|Engine/CoderEngine/Sources/Tools/Runtime/*|Engine/CoderEngine/Sources/Infrastructure/MCP/*|Engine/CoderEngine/Sources/Infrastructure/Process/*|Tools/CoderIDEMCPServer/Sources/*)
      needs_security="true"
      ;;
  esac
done

if [[ "$needs_security" == "true" || "$TRIGGER" == "ciFull" ]]; then
  if rg -n --hidden --glob '!App/SoloCodeApp/Resources/**' '(AKIA[0-9A-Z]{16}|BEGIN PRIVATE KEY|password\\s*=|token\\s*=)' "${FILES[@]}" >/tmp/solocode-validate-security.log 2>&1; then
    fail "security" "$(cat /tmp/solocode-validate-security.log)"
  fi
  pass "security"
else
  log "[SKIPPED] security"
fi

if [[ "$TRIGGER" == "gitCommit" || "$TRIGGER" == "ciFull" ]]; then
  if rg -n 'patch workflow|commit guard|validation' docs/bugs >/tmp/solocode-validate-regression.log 2>/dev/null; then
    pass "regression"
  else
    log "[SKIPPED] regression"
  fi
fi

if [[ "$TRIGGER" == "ciFull" ]]; then
  run_tests_without_building performance /tmp/solocode-validate-performance.log \
    -only-testing:CoderEngineTests/ValidationPerformanceTests
  pass "performance"
  if find Tests/SoloCodeIntegrationTests -name '*.swift' -print -quit | grep -q .; then
    run_tests_without_building e2e /tmp/solocode-validate-e2e.log -only-testing:SoloCodeIntegrationTests
    pass "e2e"
  else
    log "[SKIPPED] e2e"
  fi
fi

if [[ "$FORMAT" == "json" ]]; then
  printf '{"status":"passed","trigger":"%s","files":%s}\n' "$TRIGGER" "$(printf '%s\n' "${FILES[@]}" | python3 -c 'import json,sys; print(json.dumps([line.strip() for line in sys.stdin if line.strip()]))')"
else
  echo "Validation passed for $TRIGGER"
fi
